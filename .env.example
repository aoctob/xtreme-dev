# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Neon Postgres. Use the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Vercel Blob read/write token (Vercel → Storage → Blob). Leave empty locally to store uploads in ./media.
BLOB_READ_WRITE_TOKEN=

# Public site address, no trailing slash. Used for canonical URLs, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional -------------------------------------------------------------
# Email notifications for new applications/enquiries (Resend free tier).
# Without a key, emails are only logged to the server console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Fallback inbox if "Notification email" is empty in Site settings.
CLUB_INBOX_EMAIL=

# Cookieless analytics (Umami). Leave empty to disable.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
